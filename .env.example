# Supabase project URL and public anon key (safe to expose in client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key, SERVER ONLY. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# School data from NEIS OpenAPI (optional, no mock data will be claimed as live)
NEIS_API_KEY=
NEIS_ATPT_CODE=D10
NEIS_SCHOOL_CODE=
# HTTPS URL for the separate umbrella system
NEXT_PUBLIC_UMBRELLA_URL=

# Development-only student ID QR verification (false by default)
STUDENT_ID_ENABLED=false

# Development-only staff ID. Keep false until explicitly approved for testing.
STAFF_ID_ENABLED=false

# PWA Web Push (development only; generate with npx web-push generate-vapid-keys)
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace-with-admin@example.com
